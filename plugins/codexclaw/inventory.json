  "hooks": [
    {
      "file": "post-compact-injecting-bg-terminal-affordance.json",
      "event": "PostCompact",
      "component": "cxc-ops",
      "matcher": null
    },
    {
      "file": "post-compact-injecting-recall-context.json",
      "event": "PostCompact",
      "component": "recall",
      "matcher": null
    },
    {
      "file": "post-compact-resetting-reinject-cursor.json",
      "event": "PostCompact",
      "component": "pabcd-state",
      "matcher": null
    },
    {
      "file": "post-tool-use-capturing-interview-answers.json",
      "event": "PostToolUse",
      "component": "pabcd-state",
      "matcher": "^request_user_input$"
    },
    {
      "file": "post-tool-use-tracking-render-observations.json",
      "event": "PostToolUse",
      "component": "pabcd-state",
      "matcher": "^(view_image|browser:control-in-app-browser|chrome:control-chrome|computer-use:computer-use|apply_patch)$"
    },
    {
      "file": "pre-tool-use-attaching-skills.json",
      "event": "PreToolUse",
      "component": "subagent-config",
      "matcher": "^(collaboration[._]?)?spawn_agent$"
    },
    {
      "file": "pre-tool-use-guarding-goal-budget.json",
      "event": "PreToolUse",
      "component": "pabcd-state",
      "matcher": "^create_goal$"
    },
    {
      "file": "pre-tool-use-guarding-goal-complete.json",
      "event": "PreToolUse",
      "component": "pabcd-state",
      "matcher": "^update_goal$"
    },
    {
      "file": "pre-tool-use-guarding-interview-in-goal.json",
      "event": "PreToolUse",
      "component": "pabcd-state",
      "matcher": "^request_user_input$"
    },
    {
      "file": "pre-tool-use-guarding-managed-worktree-deletion.json",
      "event": "PreToolUse",
      "component": "pabcd-state",
      "matcher": "^Bash$"
    },
    {
      "file": "pre-tool-use-linting-apply-patch.json",
      "event": "PreToolUse",
      "component": "pabcd-state",
      "matcher": "^(apply_patch|Write|Edit)$"
    },
    {
      "file": "session-start-announcing-map-affordance.json",
      "event": "SessionStart",
      "component": "cxc-ops",
      "matcher": null
    },
    {
      "file": "session-start-bootstrapping-pabcd-state.json",
      "event": "SessionStart",
      "component": "pabcd-state",
      "matcher": null
    },
    {
      "file": "session-start-detecting-managed-worktree.json",
      "event": "SessionStart",
      "component": "pabcd-state",
      "matcher": null
    },
    {
      "file": "session-start-ensuring-provider-bridge.json",
      "event": "SessionStart",
      "component": "provider-bridge",
      "matcher": null
    },
    {
      "file": "session-start-injecting-recall-context.json",
      "event": "SessionStart",
      "component": "recall",
      "matcher": null
    },
    {
      "file": "stop-checking-pabcd-continuation.json",
      "event": "Stop",
      "component": "pabcd-state",
      "matcher": null
    },
    {
      "file": "subagent-stop-verifying-evidence.json",
      "event": "SubagentStop",
      "component": "pabcd-state",
      "matcher": "^worker$"
    },
    {
      "file": "user-prompt-submit-checking-pabcd-trigger.json",
      "event": "UserPromptSubmit",
      "component": "pabcd-state",
      "matcher": null
    },
    {
      "file": "user-prompt-submit-detecting-recall-intent.json",
      "event": "UserPromptSubmit",
      "component": "recall",
      "matcher": null
    },
    {
      "file": "user-prompt-submit-guiding-worktree-rename.json",
      "event": "UserPromptSubmit",
      "component": "pabcd-state",
      "matcher": null
    }
  ],
